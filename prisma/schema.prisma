  phone      String    @db.VarChar(50)
  whatsapp   String?   @db.VarChar(200)
  email      String    @db.VarChar(50)
  address    String    @db.VarChar(255)
  maplink    String?   @db.VarChar(255)
  status     Int       @db.TinyInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)

  @@index([status, id])
}

model control_center_redirects {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  type        String    @default("generic") @db.VarChar(30)
  source      String    @db.VarChar(500)
  target      String    @db.VarChar(500)
  status_code Int       @default(301) @db.UnsignedSmallInt
  enabled     Boolean   @default(true)
  note        String?   @db.VarChar(500)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)

  @@unique([type, source], map: "control_center_redirects_type_source_unique")
}

model coupons {
