model carts {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id BigInt    @db.UnsignedBigInt
  product_id  BigInt    @db.UnsignedBigInt
  quantity    Int       @default(1)
  price       Decimal   @db.Decimal(10, 2)
  size_id     BigInt?   @db.UnsignedBigInt
  color_id    BigInt?   @db.UnsignedBigInt
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model colors {
  id                     Int                      @id @default(autoincrement()) @db.UnsignedInt
  colorName              String?                  @db.VarChar(255)
  color                  String?                  @db.VarChar(255)
  status                 String?                  @db.VarChar(255)
  created_at             DateTime?                @db.Timestamp(0)
  updated_at             DateTime?                @db.Timestamp(0)
  product_variant_prices product_variant_prices[]
}

model complaints {
  id          BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id Int?               @db.UnsignedInt
  order_id    BigInt?            @db.UnsignedBigInt
  name        String             @db.VarChar(155)
