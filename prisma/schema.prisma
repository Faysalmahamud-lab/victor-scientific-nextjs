generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                   BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  name                 String                     @db.VarChar(255)
  shop_name            String?                    @db.VarChar(255)
  email                String                     @unique(map: "users_email_unique") @db.VarChar(255)
  emailVerifiedAt      DateTime?                  @map("email_verified_at") @db.Timestamp(0)
  password             String                     @db.VarChar(255)
  rememberToken        String?                    @map("remember_token") @db.VarChar(100)
  image                String?                    @default("public/uploads/default/user.png") @db.VarChar(255)
  status               Int?                       @default(0) @db.TinyInt
  role                 users_role                 @default(customer)
  wallet_balance       Decimal                    @default(0.00) @db.Decimal(14, 2)
  verification_status  users_verification_status? @default(pending)
  voter_id_front       String?                    @db.VarChar(255)
  voter_id_back        String?                    @db.VarChar(255)
  self_image           String?                    @db.VarChar(255)
  verification_note    String?                    @db.Text
  verified_at          DateTime?                  @db.Timestamp(0)
  vendor_id            Int?                       @db.UnsignedInt
  createdAt            DateTime?                  @map("created_at") @db.Timestamp(0)
  updatedAt            DateTime?                  @map("updated_at") @db.Timestamp(0)
  reseller_withdrawals reseller_withdrawals[]
  vendors              vendors?                   @relation(fields: [vendor_id], references: [id], onUpdate: Restrict, map: "users_vendor_id_foreign")

  @@index([vendor_id], map: "users_vendor_id_foreign")
  @@map("users")
}

model Product {
  id                       BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  product_type             products_product_type      @default(physical)
  name                     String                     @db.VarChar(255)
  slug                     String                     @db.VarChar(255)
  categoryId               Int                        @map("category_id")
  subcategoryId            Int?                       @map("subcategory_id")
  childcategoryId          Int?                       @map("childcategory_id")
  brandId                  Int?                       @map("brand_id")
  vendor_id                Int?                       @db.UnsignedInt
  productCode              String?                    @map("product_code") @db.VarChar(155)
  purchasePrice            Int?                       @default(0) @map("purchase_price")
  oldPrice                 Int?                       @map("old_price")
  newPrice                 Int                        @map("new_price")
  reseller_price           Decimal?                   @db.Decimal(14, 2)
  is_wholesale             Int                        @default(0) @db.TinyInt
  wholesale_price          Decimal?                   @db.Decimal(14, 2)
  min_wholesale_quantity   Int                        @default(1)
  advance_amount           Decimal                    @default(0.00) @db.Decimal(10, 2)
  ratting                  Float                      @default(0.0) @db.Float
  stock                    Int
  is_digital               Boolean                    @default(false)
  free_delivery            Int                        @default(0) @db.TinyInt
  digital_file             String?                    @db.VarChar(255)
  download_limit           Int?
  download_expire_days     Int?
  pro_unit                 String?
  pro_video                String?                    @db.VarChar(255)
  local_video              String?                    @db.VarChar(500)
  description              String?                    @db.LongText
  faq                      String?                    @db.LongText
  meta_title               String?                    @db.Text
  metaDescription          String?                    @map("meta_description") @db.Text
  meta_keywords            String?                    @db.Text
  meta_image               String?                    @db.VarChar(255)
  topsale                  Int?                       @db.TinyInt
  flashsale                Int?                       @db.TinyInt
  featureProduct           Int?                       @map("feature_product") @db.TinyInt
  campaignId               Int?                       @map("campaign_id")
  status                   Int                        @db.TinyInt
  approval_status          products_approval_status   @default(approved)
  sold                     String?                    @db.VarChar(255)
  note                     String?                    @db.Text
  createdAt                DateTime?                  @map("created_at") @db.Timestamp(0)
  updatedAt                DateTime?                  @map("updated_at") @db.Timestamp(0)
  model_number             String?
  origin                   String?
  capacity                 String?
  warranty                 String?
  show_product_type        Boolean                    @default(false)
  technical_specifications String?                    @db.LongText
  datasheet_path           String?                    @db.VarChar(500)
  product_variant_prices   product_variant_prices[]
  product_wholesale_prices product_wholesale_prices[]
  vendors                  vendors?                   @relation(fields: [vendor_id], references: [id], onUpdate: Restrict, map: "products_vendor_id_foreign")
  purchase_items           purchase_items[]

  @@index([slug])
  @@index([brandId, status], map: "products_brand_id_status_index")
  @@index([categoryId, status], map: "products_category_id_status_index")
  @@index([createdAt], map: "products_created_at_index")
  @@index([slug], map: "products_slug_index")
  @@index([status, categoryId], map: "products_status_category_idx")
  @@index([status, childcategoryId], map: "products_status_childcategory_idx")
  @@index([status, featureProduct], map: "products_status_feature_idx")
  @@index([status, flashsale])
  @@index([status, id])
  @@index([status, subcategoryId], map: "products_status_subcategory_idx")
  @@index([status, topsale])
  @@index([vendor_id], map: "products_vendor_id_foreign")
  @@map("products")
}

model Category {
  id                 Int                  @id @default(autoincrement()) @db.UnsignedInt
  parentId           Int                  @default(0) @map("parent_id")
  name               String               @db.VarChar(255)
  slug               String               @db.VarChar(255)
  image              String?              @default("public/uploads/category/default.png") @db.VarChar(255)
  icon               String?              @db.VarChar(255)
  metaTitle          String?              @map("meta_title")
  meta_keywords      String?              @db.Text
  meta_description   String?              @db.Text
  front_view         Int?
  status             Int                  @db.TinyInt
  createdAt          DateTime?            @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime?            @map("updated_at") @db.Timestamp(0)
  meta_keyword       String?              @db.LongText
  sort_order         Int                  @default(0) @db.UnsignedInt
  seo_content        String?              @db.LongText
  wholesale_products wholesale_products[]

  @@index([slug])
  @@index([parentId, status], map: "categories_parent_id_status_index")
  @@index([parentId, sort_order], map: "categories_parent_sort_idx")
  @@index([parentId, status, id], map: "categories_parent_status_id_idx")
  @@index([slug], map: "categories_slug_index")
  @@index([status, id])
  @@map("categories")
}

model Subcategory {
  id               Int       @id @default(autoincrement()) @db.UnsignedInt
  subcategoryName  String    @map("subcategoryName") @db.VarChar(255)
  slug             String    @db.VarChar(255)
  categoryId       Int       @map("category_id")
  image            String?   @db.Text
  metaTitle        String?   @map("meta_title")
  meta_keywords    String?   @db.Text
  meta_description String?   @db.LongText
  status           Int       @db.TinyInt
  createdAt        DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime? @map("updated_at") @db.Timestamp(0)
  sort_order       Int       @default(0) @db.UnsignedInt
  seo_content      String?   @db.LongText

  @@index([slug])
  @@index([categoryId, sort_order], map: "subcategories_category_sort_idx")
  @@index([categoryId, status], map: "subcategories_category_status_idx")
  @@map("subcategories")
}

model Childcategory {
  id                Int       @id @default(autoincrement()) @db.UnsignedInt
  childcategoryName String    @default("text") @map("childcategoryName") @db.VarChar(255)
  slug              String    @default("text") @db.VarChar(255)
  subcategoryId     Int       @default(0) @map("subcategory_id") @db.UnsignedInt
  metaTitle         String?   @map("meta_title")
  meta_keywords     String?   @db.Text
  meta_description  String?   @db.LongText
  status            Int       @db.TinyInt
  createdAt         DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime? @map("updated_at") @db.Timestamp(0)
  sort_order        Int       @default(0) @db.UnsignedInt
  seo_content       String?   @db.LongText

  @@index([slug])
  @@index([subcategoryId, sort_order], map: "childcategories_subcategory_sort_idx")
  @@index([subcategoryId, status], map: "childcategories_subcategory_status_idx")
  @@map("childcategories")
}

model ProductImage {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  image     String    @db.VarChar(255)
  productId Int       @map("product_id")
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)

  @@index([productId])
  @@map("productimages")
}

model Brand {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  name       String    @db.VarChar(255)
  slug       String    @db.VarChar(255)
  image      String?   @default("public/uploads/category/default.png") @db.VarChar(255)
  status     Int       @db.TinyInt
  sort_order Int       @default(0) @db.UnsignedInt
  createdAt  DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime? @map("updated_at") @db.Timestamp(0)

  @@index([sort_order])
  @@index([status, id])
  @@map("brands")
}

model CreatePage {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  name        String    @db.VarChar(255)
  slug        String    @db.VarChar(255)
  title       String    @db.VarChar(255)
  description String    @db.Text
  status      Int       @db.TinyInt
  createdAt   DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(0)

  @@index([status, id])
  @@map("create_pages")
}

model ContactMessage {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  fullName  String    @map("full_name") @db.VarChar(255)
  mobile    String    @db.VarChar(20)
  email     String?   @db.VarChar(255)
  subject   String?   @db.VarChar(255)
  details   String    @db.Text
  status    Boolean   @default(false)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamp(0)

  @@index([status, id])
  @@map("contact_messages")
}

model banner_categories {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  name       String    @db.VarChar(255)
  status     Int       @db.TinyInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model banners {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  category_id Int
  image       String    @db.VarChar(255)
  link        String    @db.VarChar(255)
  status      Int       @db.TinyInt
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)

  @@index([status, category_id], map: "banners_status_category_idx")
}

model blogs {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title             String    @db.VarChar(255)
  slug              String    @unique(map: "slug") @db.VarChar(255)
  short_description String?   @db.Text
  description       String    @db.LongText
  image             String?   @db.VarChar(255)
  views             Int?      @default(0)
  status            Boolean?  @default(true)
  created_at        DateTime? @default(now()) @db.Timestamp(0)
  updated_at        DateTime? @default(now()) @db.Timestamp(0)
}

model campaign_product {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  campaign_id BigInt    @db.UnsignedBigInt
  product_id  BigInt    @db.UnsignedBigInt
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)

