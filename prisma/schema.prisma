  remaining_downloads Int?      @default(0)
  expires_at          DateTime? @db.DateTime(0)
  created_at          DateTime? @db.Timestamp(0)
  updated_at          DateTime? @db.Timestamp(0)

  @@index([order_id, customer_id], map: "digital_downloads_order_id_customer_id_index")
}

model districts {
  id             Int       @id @db.UnsignedInt
  area_id        Int
  area_name      String    @db.VarChar(255)
  district       String    @db.VarChar(255)
  shippingfee    String    @db.VarChar(255)
  partialpayment String    @db.VarChar(255)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
}

model ecom_pixels {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  code       String    @db.VarChar(255)
  status     Int       @db.TinyInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model employee_attendances {
  id              BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  employee_id     BigInt                      @db.UnsignedBigInt
  attendance_date DateTime                    @db.Date
  check_in        DateTime?                   @db.Time(0)
  check_out       DateTime?                   @db.Time(0)
  status          employee_attendances_status @default(present)
  notes           String?                     @db.Text
  marked_by       Int?                        @db.UnsignedInt
  created_at      DateTime?                   @db.Timestamp(0)
  updated_at      DateTime?                   @db.Timestamp(0)
  employees       employees                   @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "employee_attendances_employee_id_foreign")

  @@unique([employee_id, attendance_date], map: "employee_attendances_employee_id_attendance_date_unique")
  @@index([attendance_date], map: "employee_attendances_attendance_date_index")
  @@index([status], map: "employee_attendances_status_index")
}

model employee_bonuses {
