  created_at               DateTime?                          @db.Timestamp(0)
  updated_at               DateTime?                          @db.Timestamp(0)
  wholesale_product_images wholesale_product_images[]
  categories               Category                           @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "wholesale_products_category_id_foreign")
  vendors                  vendors?                           @relation(fields: [vendor_id], references: [id], onUpdate: Restrict, map: "wholesale_products_vendor_id_foreign")

  @@index([approval_status], map: "wholesale_products_approval_status_index")
  @@index([category_id], map: "wholesale_products_category_id_index")
  @@index([status], map: "wholesale_products_status_index")
  @@index([vendor_id], map: "wholesale_products_vendor_id_index")
}

