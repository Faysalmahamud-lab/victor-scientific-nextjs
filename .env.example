# Create .env in the application root. Never place it inside public_html.
NEXT_PUBLIC_SITE_URL=https://shop.victorscientificbd.com
NEXT_PUBLIC_SITE_NAME=Victor Scientific Co.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Use the NEW staging database imported from the supplied SQL backup.
# URL-encode special characters in the password (@, #, %, /, :, etc.).
DATABASE_URL="mysql://CPANEL_DB_USER:URL_ENCODED_PASSWORD@localhost:3306/CPANEL_DB_NAME"
DB_CONNECTION_LIMIT=5

# Leave blank until the actual administrator account and role are verified.
ADMIN_ALLOWED_EMAILS=

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Public store details. Fill only with verified business information.
NEXT_PUBLIC_STORE_ADDRESS="10 Hatkhola Road, Kader Tropical Heights (2nd floor), Tikatuli, Dhaka 1203"
NEXT_PUBLIC_STORE_PHONE=01844-572826
NEXT_PUBLIC_STORE_MAP_URL="https://www.google.com/maps/search/?api=1&query=Victor%20Scientific%20Co.%2C%20Kader%20Tropical%20Heights%2C%2010%20Hatkhola%20Rd%2C%20Dhaka%201203"
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_MESSENGER_URL=https://m.me/101985647846888

# Keep disabled until the staging order workflow, stock policy and admin order handling are verified.
CHECKOUT_ENABLED=false
