    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "jose": "^6.1.3",
    "lucide-react": "^0.468.0",
    "mariadb": "^3.4.5",
    "motion": "^12.23.24",
    "next": "16.2.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "server-only": "^0.0.1",
    "swiper": "^12.0.3",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
